---
import XiuxianGame from "@components/pages/XiuxianGame.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import xiuxianBg from "@/assets/images/yanami/xiuxian-bg.jpg";
import elixirImg from "@/assets/images/yanami/xiuxian-elixir.png";
import "@/styles/pages/common.css";
---

<MainGridLayout title="修仙修炼" description="闭关修炼，突破境界，成就大道">
  <div class="flex w-full flex-col rounded-(--radius-large) overflow-hidden relative min-h-32">
    <!-- 水墨仙侠横幅背景 -->
    <div class="relative h-44 md:h-60 shrink-0">
      <img src={xiuxianBg.src} alt="水墨仙侠" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>
      <div class="absolute bottom-4 inset-x-9">
        <h2 class="text-2xl md:text-3xl font-bold text-white drop-shadow-lg">修仙修炼</h2>
        <p class="text-sm text-white/85 drop-shadow">持续打坐吐纳 · 炼丹服丹 · 渡劫破境</p>
      </div>
    </div>

    <div class="card-base z-10 px-9 py-6 relative w-full">
      <XiuxianGame client:load />

      <div class="mt-8 pt-6 border-t border-dashed border-(--line-divider)">
        <div class="grid md:grid-cols-[1fr_auto] gap-6 items-start">
          <div>
            <h3 class="text-lg font-semibold mb-3">修炼体系</h3>
            <div class="grid gap-2 text-sm text-(--content-meta)">
              <div class="flex justify-between"><span>炼气期</span><span>100 修为</span></div>
              <div class="flex justify-between"><span>筑基期</span><span>300 修为</span></div>
              <div class="flex justify-between"><span>金丹期</span><span>800 修为</span></div>
              <div class="flex justify-between"><span>元婴期</span><span>2000 修为</span></div>
              <div class="flex justify-between"><span>化神期</span><span>5000 修为</span></div>
              <div class="flex justify-between"><span>合体期</span><span>12000 修为</span></div>
              <div class="flex justify-between"><span>渡劫期</span><span>30000 修为</span></div>
              <div class="flex justify-between"><span>大乘期</span><span>80000 修为</span></div>
              <div class="flex justify-between"><span>飞升境</span><span>圆满</span></div>
            </div>
          </div>
          <!-- 丹药配图 -->
          <div class="w-40 md:w-52 shrink-0 rounded-xl overflow-hidden border border-(--line-divider)">
            <img src={elixirImg.src} alt="丹药" class="w-full h-auto" loading="lazy" />
            <p class="text-xs text-(--content-meta) text-center py-2">机缘所至 · 丹药助道</p>
          </div>
        </div>
        <p class="text-xs text-(--content-meta) mt-4 opacity-75">
          开始打坐后每 2 秒吐纳一息，修为随境界增长；打坐中偶有机缘（修为大涨、掉落丹药）与心魔（损失修为）。
          突破成功率随目标境界降低（保底 30%），破境丹可 +25%；丹药可凭机缘获得，也能用修为在炼丹坊炼制。
        </p>
      </div>
    </div>
  </div>
</MainGridLayout>
