---
import XiuxianMap from "@components/pages/XiuxianMap.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import xiuxianBg from "@/assets/images/yanami/xiuxian-bg.jpg";
import "@/styles/pages/common.css";
---

<MainGridLayout title="境界图谱" description="修仙九境，步步登天">
  <div class="flex w-full flex-col rounded-(--radius-large) overflow-hidden relative min-h-32">
    <!-- 水墨仙侠横幅背景 -->
    <div class="relative h-40 md:h-52 shrink-0">
      <img src={xiuxianBg.src} alt="水墨仙侠" class="w-full h-full object-cover" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-black/15 to-transparent"></div>
      <div class="absolute bottom-4 inset-x-9">
        <h2 class="text-2xl md:text-3xl font-bold text-white drop-shadow-lg">境界图谱</h2>
        <p class="text-sm text-white/85 drop-shadow">修仙九境，从炼气到飞升</p>
      </div>
    </div>

    <div class="card-base z-10 px-9 py-6 relative w-full">
      <XiuxianMap client:load />
    </div>
  </div>
</MainGridLayout>
