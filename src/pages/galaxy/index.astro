---
import Layout from "@/layouts/Layout.astro";
import GalaxyScene from "@components/pages/GalaxyScene.svelte";
---

<Layout
  title="银河漫游"
  description="Three.js 模拟螺旋星系 —— 拖拽旋转视角，滚轮缩放，穿梭数字星河"
>
  <div class="galaxy-page">
    <GalaxyScene client:only="svelte" />

    <!-- 左侧 Python 代码装饰层：还原"代码为轨"的视频氛围，随动画缓慢上滚 -->
    <div class="code-panel" aria-hidden="true">
      <pre class="code-scroll">{`import random
from math import sin, cos, pi, log
from tkinter import *

CANVAS_WIDTH  = 640
CANVAS_HEIGHT = 480

# 3D 爱心隐式曲面
def heart_surface(x, y, z):
    a = x*x + (9/4)*z*z + y*y - 1
    return a**3 - x*x*y**3 - (9/80)*z*z*y**3

def scatter_inside(x, y, beta=0.15):
    rx = -beta * log(random.random())
    ry = -beta * log(random.random())
    dx = rx * (x - CANVAS_WIDTH/2)
    dy = ry * (y - CANVAS_HEIGHT/2)
    return x - dx, y - dy

# 蝴蝶参数曲线
def butterfly(t):
    f = exp(cos(t)) - 2*cos(4*t) \\
        - sin(t/12)**5
    return sin(t)*f, cos(t)*f

# 火箭：圆锥 + 圆柱 + 尾翼
def rocket(u, v):
    x = -0.55 + u
    r = 0.22
    return x, cos(v*2*pi)*r, sin(v*2*pi)*r

class Orbit:
    def __init__(self):
        self.points = []
        self.phase  = "form"
        self.rot    = 0.0

    def morph(self, target):
        for p in self.points:
            p.seek(target, rate=0.08)

    def cruise(self):
        # 以代码为轨，穿梭数字星河
        self.pos += self.dir * 0.9

while True:
    orbit.morph(shapes[i])
    orbit.cruise()
    i = (i + 1) % len(shapes)`}</pre>
    </div>

    <!-- 入场遮罩：标题打字 + 辉光，点击"进入星河"后曲速冲刺 -->
    <div id="galaxy-intro" class="galaxy-intro" role="dialog" aria-label="数字星河入口">
      <div class="intro-inner">
        <p class="intro-tag"><span id="galaxy-typewriter"></span><span class="caret">▋</span></p>
        <h1 class="intro-title">
          <span class="line">以代码为轨</span>
          <span class="dot"> · </span>
          <span class="line alt">穿梭数字星河</span>
        </h1>
        <p class="intro-sub">0 与 1 化作星尘，字符流勾勒轨道 —— 一场属于代码的宇宙航行</p>
        <button id="galaxy-enter" class="intro-btn" type="button">
          进入星河
          <span class="enter-arrow">→</span>
        </button>
        <p class="intro-hint">拖拽旋转视角 · 滚轮缩放 · 右键平移</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  // 本页无 #swup-container 结构：销毁 swup 实例，
  // 让返回/前进退回浏览器原生整页导航，避免容器失配导致其他页面模块丢失
  if (window.swup) window.swup.destroy();

  // 标题打字机：逐字打出代码风格标语（纯 JS，.astro 内联脚本不经 TS 编译）
  const PHRASE = "// CODE AS ORBIT · GALAXY.SHUTTLE";
  const tw = document.getElementById("galaxy-typewriter");
  const intro = document.getElementById("galaxy-intro");
  const btn = document.getElementById("galaxy-enter");

  if (tw) {
    let i = 0;
    const timer = setInterval(() => {
      tw.textContent = PHRASE.slice(0, (i += 1));
      if (i >= PHRASE.length) clearInterval(timer);
    }, 55);
  }

  if (btn && intro) {
    btn.addEventListener("click", () => {
      intro.classList.add("is-leaving");
      // 过渡结束后彻底关闭遮罩，让出指针事件
      setTimeout(() => intro.remove(), 1200);
    });
  }
</script>

<style>
  .galaxy-page {
    position: fixed;
    inset: 0;
    z-index: 5;
    overflow: hidden;
    background: #05060f;
  }

  /* 左侧代码装饰面板：还原视频左半屏的 Python 代码氛围 */
  .code-panel {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 1.2rem;
    width: 24rem;
    z-index: 6;
    overflow: hidden;
    pointer-events: none;
    opacity: 0.34;
    /* 上下渐隐，融入深空背景 */
    mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 12%, #000 88%, transparent);
  }
  .code-scroll {
    font-family: ui-monospace, "JetBrains Mono", Consolas, monospace;
    font-size: 0.72rem;
    line-height: 1.75;
    color: #7dd3fc;
    text-shadow: 0 0 8px rgba(56, 189, 248, 0.4);
    white-space: pre;
    animation: code-scroll 28s linear infinite alternate;
  }
  @keyframes code-scroll {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-32%);
    }
  }
  /* 窄屏隐藏代码面板，避免遮挡粒子主体 */
  @media (max-width: 1023px) {
    .code-panel {
      display: none;
    }
  }

  .galaxy-intro {
    position: fixed;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 1.5rem;
    background: radial-gradient(ellipse at center, rgba(5, 6, 15, 0.35) 0%, rgba(5, 6, 15, 0.78) 100%);
    backdrop-filter: blur(2px);
    transition:
      opacity 1s ease,
      transform 1s ease;
  }
  .galaxy-intro.is-leaving {
    opacity: 0;
    transform: scale(1.06);
    pointer-events: none;
  }

  .intro-inner {
    max-width: 46rem;
  }

  .intro-tag {
    font-family:
      ui-monospace, "JetBrains Mono", Consolas, monospace;
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    color: #67e8f9;
    min-height: 1.4em;
    margin-bottom: 1.4rem;
    text-shadow: 0 0 14px rgba(103, 232, 249, 0.55);
  }
  .caret {
    animation: blink 1s steps(1) infinite;
    color: #818cf8;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .intro-title {
    font-size: clamp(2rem, 6vw, 4.2rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.35;
    margin: 0 0 1.2rem;
    color: #f8fafc;
  }
  .intro-title .line {
    display: inline-block;
    opacity: 0;
    transform: translateY(26px);
    animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    text-shadow: 0 0 30px rgba(129, 140, 248, 0.45);
  }
  .intro-title .line:first-child {
    animation-delay: 0.25s;
  }
  .intro-title .dot {
    opacity: 0;
    animation: fadeIn 0.6s ease 0.7s forwards;
    color: #818cf8;
  }
  .intro-title .alt {
    animation-delay: 0.65s;
    background: linear-gradient(100deg, #67e8f9 10%, #818cf8 55%, #c084fc 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
    filter: drop-shadow(0 0 22px rgba(129, 140, 248, 0.35));
  }

  .intro-sub {
    font-size: clamp(0.85rem, 1.8vw, 1rem);
    color: #94a3b8;
    letter-spacing: 0.06em;
    margin: 0 0 2.4rem;
    opacity: 0;
    animation: fadeIn 1s ease 1s forwards;
  }

  .intro-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 2.2rem;
    font-family:
      ui-monospace, "JetBrains Mono", Consolas, monospace;
    font-size: 0.95rem;
    letter-spacing: 0.22em;
    color: #e0f2fe;
    background: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(103, 232, 249, 0.55);
    border-radius: 999px;
    cursor: pointer;
    overflow: hidden;
    opacity: 0;
    animation: fadeIn 1s ease 1.3s forwards;
    transition:
      box-shadow 0.3s ease,
      border-color 0.3s ease,
      background 0.3s ease;
  }
  .intro-btn:hover {
    border-color: #67e8f9;
    background: rgba(56, 189, 248, 0.18);
    box-shadow:
      0 0 28px rgba(103, 232, 249, 0.35),
      inset 0 0 18px rgba(103, 232, 249, 0.12);
  }
  .enter-arrow {
    transition: transform 0.3s ease;
  }
  .intro-btn:hover .enter-arrow {
    transform: translateX(6px);
  }

  .intro-hint {
    margin-top: 1.8rem;
    font-size: 0.78rem;
    color: #64748b;
    letter-spacing: 0.1em;
    opacity: 0;
    animation: fadeIn 1s ease 1.6s forwards;
  }

  @keyframes rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-title .line,
    .intro-title .dot,
    .intro-sub,
    .intro-btn,
    .intro-hint {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
